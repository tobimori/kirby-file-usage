{
	"name": "tobimori/kirby-file-usage",
	"description": "See where files are used in Kirby: on which pages, in which fields and blocks, and which files are not used at all",
	"type": "kirby-plugin",
	"version": "1.0.0",
	"license": "MIT",
	"homepage": "https://github.com/tobimori/kirby-file-usage#readme",
	"authors": [
		{
			"name": "Tobias Möritz",
			"email": "tobias@moeritz.io"
		}
	],
	"autoload": {
		"psr-4": {
			"tobimori\\FileUsage\\": "classes"
		}
	},
	"require": {
		"php": ">=8.3.0",
		"getkirby/composer-installer": "^1.2.1"
	},
	"require-dev": {
		"carthage-software/mago": "^1.58.2",
		"getkirby/cms": "^6.0.0"
	},
	"scripts": {
		"analyze": "mago analyze",
		"dist": "composer install --no-dev --optimize-autoloader",
		"fix": [
			"mago lint --fix",
			"mago fmt"
		],
		"fmt": "mago fmt",
		"fmt:check": "mago fmt --check",
		"lint": "mago lint"
	},
	"config": {
		"optimize-autoloader": true,
		"allow-plugins": {
			"carthage-software/mago": true,
			"getkirby/composer-installer": true
		}
	},
	"extra": {
		"kirby": {
			"compatible": "^6.0"
		},
		"kirby-cms-path": false
	}
}
